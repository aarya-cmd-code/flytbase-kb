# --- Supabase ---
# Project Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # server-side only, never expose to the browser

# --- LLM (classification, synthesis, summaries) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Embeddings (for the customer-data vector index) ---
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small

# --- Live docs retrieval (Problem #2) ---
# Optional: if set, docs_fetch.js will use this search API instead of the
# built-in sitemap+keyword fallback for better live-doc retrieval quality.
# e.g. Serper.dev, SerpAPI, Bing Web Search, etc.
SEARCH_API_KEY=
SEARCH_API_URL=

PORT=3000
